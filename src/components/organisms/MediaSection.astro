---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { cmsMedia } from "@utils/cms";
import { Icon } from "astro-icon/components";
---

<section class="media-section onload-animation">
    <h1 id="media-title"><Icon name="material-symbols:menu-book-rounded" aria-hidden="true" />{i18n(I18nKey.media)}</h1>
    <p>{i18n(I18nKey.mediaDescription)}</p>
    {cmsMedia.length === 0 ? <div class="media-section__empty">{i18n(I18nKey.mediaEmpty)}</div> : <div class="media-section__grid">
      {cmsMedia.map(item => <article class="media-item" data-kind={item.kind}>
        {item.cover && <img src={item.cover} alt={item.title} loading="lazy" width="240" height="320" />}
        <div><span class="media-item__type">{i18n(item.kind === "movie" ? I18nKey.cmsMovie : I18nKey.cmsBook)}</span>
        <h2>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}</h2>
        {item.creator && <p>{item.creator}</p>}
        {item.status && <p>{i18n(item.status === "completed" ? I18nKey.cmsCompleted : item.status === "in-progress" ? I18nKey.cmsInProgress : I18nKey.cmsPlanned)}</p>}
        {item.rating !== undefined && <p>{i18n(I18nKey.cmsRating)} {item.rating} / 10</p>}
        {item.date && <time datetime={item.date}>{item.date}</time>}
        {item.description && <p class="media-item__description">{item.description}</p>}</div>
      </article>)}
    </div>}
</section>

<style>
    .media-section {
        padding: 2rem;
        border-radius: var(--shape-corner-l);
        background: var(--card-bg);
        color: var(--on-surface);
    }
    h1 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font: var(--m3e-type-headline-medium);
    }
    h1 svg { color: var(--primary); }
    p { margin-top: 0.5rem; font: var(--m3e-type-body-medium); color: var(--on-surface-variant); }
    .media-section__empty {
        padding: 4rem 1rem;
        text-align: center;
        font: var(--m3e-type-body-large);
        color: var(--on-surface-variant);
    }
    .media-section__grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,280px),1fr)); gap: 1rem; margin-top: 1.5rem; }
    .media-item { display: flex; align-items: start; gap: 1rem; padding: 1rem; border-radius: var(--shape-corner-m); background: var(--surface-container-low); }
    .media-item img { width: 90px; height: 120px; object-fit: cover; border-radius: var(--shape-corner-s); }
    .media-item__type { color: var(--primary); font: var(--m3e-type-label-medium); }
    h2 { font: var(--m3e-type-title-large); margin-block: .5rem; }
    a { color: var(--primary); } .media-item__description { white-space: pre-wrap; }
</style>
