---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrl, url } from "@utils/url-utils";
import { vaultSeries } from "@utils/vault-content";

interface Props {
	series?: string;
	current: string;
}
const { series, current } = Astro.props;
const group = vaultSeries.find((s) => s.key === series);
const posts = group
	? (await getSortedPosts())
			.filter((p) => p.data.series === series)
			.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
	: [];
---
{group && posts.length > 0 && <nav class="series-navigation" aria-label={i18n(I18nKey.vaultSeries)}>
  <h2><a href={url(`/series/${encodeURIComponent(group.key)}/`)}>{group.title}</a></h2>
  <ol>{posts.map(p => <li><a href={getPostUrl(p)} aria-current={p.id === current ? "page" : undefined}>{p.data.title}</a></li>)}</ol>
</nav>}
<style>
.series-navigation { margin-block: 1.5rem; padding: 1.25rem; border-radius: var(--shape-corner-l); background: var(--surface-container-low); color: var(--on-surface); }
h2 { font: var(--m3e-type-title-medium); margin: 0 0 .75rem; }
a { color: var(--primary); } ol { padding-inline-start: 1.5rem; } li { padding-block: .25rem; }
[aria-current="page"] { font-weight: 700; }
</style>
