---
import { createHash } from "node:crypto";
import { Icon } from "astro-icon/components";
import { announcementConfig } from "@/config/announcementConfig";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { announcementLink } from "@/utils/announcement-link";
import { url } from "@/utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const config = announcementConfig;
interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
// An explicit empty list must not fall back to the theme's demo announcement.
const items =
	config.homeItems ??
	(config.content || config.text
		? [
				{
					title: "",
					content: config.content || config.text || "",
					link: config.link,
					date: undefined,
					tag: undefined,
				},
			]
		: []);
const version = createHash("sha256")
	.update(JSON.stringify(items))
	.digest("hex");
---

{items.length > 0 && (
	<WidgetLayout name={config.title || i18n(I18nKey.announcement)} id="announcement" class={className} style={style}>
		<div class="announcement-wrapper flex flex-col gap-4" data-close-duration={String(config.closeDuration ?? 86400)} data-version={version}>
			{items.map((item) => {
				const link = item.link;
				const hasLink = link?.url && link.enable !== false;
				const destination = announcementLink(link?.url || "", siteConfig.site);
				const external = destination.external;
				return (
					<article class="announcement-item flex flex-col gap-2">
						{item.title && <p class="text-90 font-medium text-sm break-words">{item.title}</p>}
						{item.tag && <span class="text-75 text-xs">{item.tag}</span>}
						{item.date && <time class="text-75 text-xs">{item.date}</time>}
						<p class="text-75 leading-relaxed break-words whitespace-pre-line text-sm">{item.content}</p>
						{hasLink && <a href={!external && destination.href.startsWith("/") ? url(destination.href) : destination.href}
							target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}
							class="announcement-btn self-start inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-[var(--shape-corner-s)] bg-[var(--btn-regular-bg)] text-[var(--primary)] hover:bg-[var(--btn-regular-bg-hover)] transition-colors">
							<span>{link.text || i18n(I18nKey.more)}</span>
							{external && <Icon name="material-symbols:arrow-outward-rounded" class="text-sm" aria-hidden="true" />}
						</a>}
					</article>
				);
			})}
			{config.closable && <button type="button" data-announcement-close
				class="announcement-close-btn self-end h-7 w-7 flex items-center justify-center rounded-[var(--shape-corner-s)] bg-[var(--btn-regular-bg)] text-75 hover:text-[var(--error)] cursor-pointer"
				aria-label={i18n(I18nKey.announcementClose)} title={i18n(I18nKey.announcementClose)}>
				<Icon name="material-symbols:close-rounded" class="text-base" aria-hidden="true" />
			</button>}
		</div>
	</WidgetLayout>
)}

<script>
	import { initAnnouncements } from "@/utils/announcement-runtime";
	initAnnouncements();
</script>
